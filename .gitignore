# ============================================
# fMRI Preprocessing Project .gitignore
# ============================================

# --------------------------------------------
# LARGE DATA DIRECTORIES (260GB+ total)
# --------------------------------------------
# Raw BIDS dataset from OpenNeuro
ds004302-download/

# fMRIPrep working directory (intermediate files)
work/

# fMRIPrep output directory (preprocessed data)
output/

# Quality analysis outputs
quality_analysis/

# --------------------------------------------
# LOG FILES
# --------------------------------------------
logs/
*.log

# --------------------------------------------
# PYTHON-GENERATED FILES
# --------------------------------------------
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
*.egg

# Python bytecode
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/

# --------------------------------------------
# JUPYTER NOTEBOOKS
# --------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# --------------------------------------------
