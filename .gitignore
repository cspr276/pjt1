*.nii
*.nii.gz

# FreeSurfer files
*.mgh
*.mgz

# Other neuroimaging formats
*.nrrd
*.mnc
*.mnc.gz
*.head
*.brik
*.brik.gz

# Singularity containers
*.sif
*.simg

